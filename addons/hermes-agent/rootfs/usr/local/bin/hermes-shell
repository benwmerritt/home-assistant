#!/usr/bin/env bash
set -euo pipefail

cd "${HERMES_HOME:-/data/hermes}"

PROFILE_FILE="${HOME:-/data/hermes}/.bash_profile"
mkdir -p "$(dirname "${PROFILE_FILE}")"
touch "${PROFILE_FILE}"

if ! grep -q "HERMES_AGENT_ADDON_PATH" "${PROFILE_FILE}"; then
    cat >>"${PROFILE_FILE}" <<'PROFILE'

# HERMES_AGENT_ADDON_PATH
case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) export PATH="${PATH}:${HOME}/.local/bin" ;;
esac
PROFILE
fi

cat <<'TEXT'
Hermes Agent add-on terminal

Useful commands:
  hermes setup --portal
  hermes setup
  hermes setup gateway
  hermes model
  hermes --tui
  hermes gateway status

State is stored in /data/hermes on the Home Assistant host.

TEXT

exec bash -l
